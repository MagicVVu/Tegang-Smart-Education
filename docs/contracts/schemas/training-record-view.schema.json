{
  "$defs": {
    "LearningRecordStatus": {
      "description": "Employee learning states from chapter 15.8.",
      "enum": [
        "LR-PENDING",
        "LR-LEARNING",
        "LR-WAIT-ASSESSMENT",
        "LR-NOT-MET",
        "LR-REMEDIAL",
        "LR-WAIT-RETEST",
        "LR-RETESTING",
        "LR-COMPLETED",
        "LR-PAUSED"
      ],
      "title": "LearningRecordStatus",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.0.0:training-record-view",
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "learning_status": {
      "$ref": "#/$defs/LearningRecordStatus"
    },
    "result_summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Result Summary",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "description": "Immutable external training task ID: task_<ULID>.",
      "examples": [
        "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_name": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Task Name",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "task_name",
    "learning_status",
    "result_summary"
  ],
  "title": "TrainingRecordView",
  "type": "object",
  "x-contract-schema-version": "2.0.0",
  "x-contract-source": "backend.app.schemas.experience.TrainingRecordView"
}
