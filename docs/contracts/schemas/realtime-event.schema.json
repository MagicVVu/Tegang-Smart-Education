{
  "$defs": {
    "AgentEventType": {
      "enum": [
        "agent_stage_changed",
        "skill_started",
        "skill_succeeded",
        "skill_failed",
        "rule_blocked",
        "approval_required",
        "approval_decided",
        "plan_replanned",
        "run_retried",
        "run_rolled_back",
        "human_takeover_required",
        "run_completed",
        "run_failed"
      ],
      "title": "AgentEventType",
      "type": "string"
    },
    "AgentProgressPayload": {
      "additionalProperties": false,
      "description": "Typed payload for Agent progress events.",
      "properties": {
        "checkpoint_id": {
          "anyOf": [
            {
              "description": "Agent checkpoint ID: checkpoint_<ULID>.",
              "examples": [
                "checkpoint_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^checkpoint_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Id"
        },
        "confidence": {
          "anyOf": [
            {
              "description": "Model or retrieval confidence in the closed interval [0, 1].",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "description": "Creation time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "entity_version": {
          "default": 1,
          "description": "Optimistic entity revision, independent of schema_version.",
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "formal_write_occurred": {
          "default": false,
          "title": "Formal Write Occurred",
          "type": "boolean"
        },
        "id": {
          "description": "Immutable Agent step ID: step_<ULID>.",
          "examples": [
            "step_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^step_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "description": "Caller-generated idempotency key. It is not a domain entity ID.",
              "examples": [
                "idem_training_create_20260804_001"
              ],
              "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
          "title": "Metadata",
          "type": "object"
        },
        "progress_percent": {
          "description": "Percentage value in the closed interval [0, 100].",
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Progress Percent",
          "type": "number"
        },
        "request_id": {
          "anyOf": [
            {
              "description": "Single request ID: req_<ULID>.",
              "examples": [
                "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retry_count": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "run_id": {
          "description": "Immutable Agent run ID: run_<ULID>.",
          "examples": [
            "run_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "2.0.0",
          "description": "Contract schema semantic version.",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentStepStatus"
        },
        "step_id": {
          "description": "Immutable Agent step ID: step_<ULID>.",
          "examples": [
            "step_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^step_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Step Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "description": "Cross-service trace ID: trc_<ULID>.",
              "examples": [
                "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "updated_at": {
          "description": "Last update time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "updated_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated By"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "id",
        "status",
        "run_id",
        "step_id",
        "progress_percent",
        "summary"
      ],
      "title": "AgentProgressPayload",
      "type": "object"
    },
