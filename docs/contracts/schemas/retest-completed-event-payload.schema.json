{
  "$defs": {
    "RetestStatus": {
      "enum": [
        "waiting",
        "in_progress",
        "completed",
        "manual",
        "cancelled"
      ],
      "title": "RetestStatus",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.2.0:retest-completed-event-payload",
  "additionalProperties": false,
  "properties": {
    "assessment_result_id": {
      "anyOf": [
        {
          "description": "Immutable assessment result ID: assessment_result_<ULID>.",
          "examples": [
            "assessment_result_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^assessment_result_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assessment Result Id"
    },
    "employee_profile_id": {
      "description": "Immutable external employee profile ID: emp_<ULID>.",
      "examples": [
        "emp_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^emp_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Employee Profile Id",
      "type": "string"
    },
    "retest_id": {
      "description": "Immutable retest ID: retest_<ULID>.",
      "examples": [
        "retest_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^retest_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Retest Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RetestStatus"
    },
    "task_id": {
      "description": "Immutable external training task ID: task_<ULID>.",
      "examples": [
        "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "retest_id",
    "task_id",
    "employee_profile_id",
    "status"
  ],
  "title": "RetestCompletedEventPayload",
  "type": "object",
  "x-contract-schema-version": "2.2.0",
  "x-contract-source": "backend.app.schemas.events.RetestCompletedEventPayload"
}
