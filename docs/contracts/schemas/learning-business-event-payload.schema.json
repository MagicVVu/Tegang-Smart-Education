{
  "$defs": {
    "LearningRecordStatus": {
      "description": "Employee learning states from chapter 15.8.",
      "enum": [
        "LR-PENDING",
        "LR-LEARNING",
        "LR-WAIT-ASSESSMENT",
        "LR-NOT-MET",
        "LR-REMEDIAL",
        "LR-WAIT-RETEST",
        "LR-RETESTING",
        "LR-COMPLETED",
        "LR-PAUSED"
      ],
      "title": "LearningRecordStatus",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.1.0:learning-business-event-payload",
  "additionalProperties": false,
  "properties": {
    "employee_profile_id": {
      "description": "Immutable external employee profile ID: emp_<ULID>.",
      "examples": [
        "emp_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^emp_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Employee Profile Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/LearningRecordStatus"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "description": "Immutable external training task ID: task_<ULID>.",
      "examples": [
        "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "employee_profile_id",
    "status",
    "summary"
  ],
  "title": "LearningBusinessEventPayload",
  "type": "object",
  "x-contract-schema-version": "2.1.0",
  "x-contract-source": "backend.app.schemas.events.LearningBusinessEventPayload"
}
