{
  "$defs": {
    "AssessmentSessionStatus": {
      "enum": [
        "pending",
        "in_progress",
        "submitted",
        "scored",
        "cancelled"
      ],
      "title": "AssessmentSessionStatus",
      "type": "string"
    },
    "RiskLevel": {
      "description": "Risk grading aligned with the document's read-only/low/medium/high levels.",
      "enum": [
        "read_only",
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.0.0:assessment-session",
  "additionalProperties": false,
  "description": "One employee's one assessment attempt for a training task.",
  "properties": {
    "attempt": {
      "maximum": 100,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "confidence": {
      "anyOf": [
        {
          "description": "Model or retrieval confidence in the closed interval [0, 1].",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "created_at": {
      "description": "Creation time with timezone; serialized as ISO 8601.",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "anyOf": [
        {
          "description": "Immutable external user ID: usr_<ULID>.",
          "examples": [
            "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By"
    },
    "employee_profile_id": {
      "description": "Immutable external employee profile ID: emp_<ULID>.",
      "examples": [
        "emp_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^emp_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Employee Profile Id",
      "type": "string"
    },
    "entity_version": {
      "default": 1,
      "description": "Optimistic entity revision, independent of schema_version.",
      "minimum": 1,
      "title": "Entity Version",
      "type": "integer"
    },
    "id": {
      "description": "Immutable assessment session ID: assessment_<ULID>.",
      "examples": [
        "assessment_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^assessment_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "description": "Caller-generated idempotency key. It is not a domain entity ID.",
          "examples": [
            "idem_training_create_20260804_001"
          ],
          "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
      "title": "Metadata",
      "type": "object"
    },
    "request_id": {
      "anyOf": [
        {
          "description": "Single request ID: req_<ULID>.",
          "examples": [
            "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel",
      "default": "low"
    },
    "schema_version": {
      "default": "2.0.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/AssessmentSessionStatus"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "task_id": {
      "description": "Immutable external training task ID: task_<ULID>.",
      "examples": [
        "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Task Id",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "description": "Cross-service trace ID: trc_<ULID>.",
          "examples": [
            "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "updated_at": {
      "description": "Last update time with timezone; serialized as ISO 8601.",
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "updated_by": {
      "anyOf": [
        {
          "description": "Immutable external user ID: usr_<ULID>.",
          "examples": [
            "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated By"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "id",
    "status",
    "task_id",
    "employee_profile_id",
    "attempt"
  ],
  "title": "AssessmentSession",
  "type": "object",
  "x-contract-schema-version": "2.0.0",
  "x-contract-source": "backend.app.schemas.assessment.AssessmentSession"
}
