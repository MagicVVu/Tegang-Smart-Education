{
  "$defs": {
    "UserRole": {
      "enum": [
        "employee",
        "training_admin",
        "reviewer",
        "system_admin"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.1.0:api-request-context",
  "additionalProperties": false,
  "description": "Common API request context; role and department remain server-verified assertions.",
  "properties": {
    "actor_id": {
      "description": "Immutable external user ID: usr_<ULID>.",
      "examples": [
        "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Actor Id",
      "type": "string"
    },
    "actor_role": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "department_id": {
      "anyOf": [
        {
          "description": "Immutable external department ID: dept_<ULID>.",
          "examples": [
            "dept_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^dept_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Department Id"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "description": "Caller-generated idempotency key. It is not a domain entity ID.",
          "examples": [
            "idem_training_create_20260804_001"
          ],
          "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "request_id": {
      "description": "Single request ID: req_<ULID>.",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested At"
    },
    "schema_version": {
      "default": "2.1.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "anyOf": [
        {
          "description": "Cross-service trace ID: trc_<ULID>.",
          "examples": [
            "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    }
  },
  "required": [
    "request_id",
    "actor_id"
  ],
  "title": "ApiRequestContext",
  "type": "object",
  "x-contract-schema-version": "2.1.0",
  "x-contract-source": "backend.app.schemas.common.ApiRequestContext"
}
