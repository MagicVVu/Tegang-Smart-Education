{
  "$defs": {
    "ApiResponseMeta": {
      "additionalProperties": false,
      "description": "Optional response metadata; non-list responses do not emit empty pagination.",
      "properties": {
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageNumberPaginationMeta"
            },
            {
              "$ref": "#/$defs/CursorPaginationMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pagination"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "ApiResponseMeta",
      "type": "object"
    },
    "CursorPaginationMeta": {
      "additionalProperties": false,
      "description": "Cursor metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "cursor",
          "default": "cursor",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "page_size"
      ],
      "title": "CursorPaginationMeta",
      "type": "object"
    },
    "PageNumberPaginationMeta": {
      "additionalProperties": false,
      "description": "Page-number metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "page_size",
        "total"
      ],
      "title": "PageNumberPaginationMeta",
      "type": "object"
    },
    "RemediationIntervention": {
      "additionalProperties": false,
      "description": "Targeted follow-up learning created from an assessment result.",
      "properties": {
        "assessment_result_id": {
          "description": "Immutable assessment result ID: assessment_result_<ULID>.",
          "examples": [
            "assessment_result_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^assessment_result_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Assessment Result Id",
          "type": "string"
        },
        "attempt": {
          "maximum": 100,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "confidence": {
          "anyOf": [
            {
              "description": "Model or retrieval confidence in the closed interval [0, 1].",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "description": "Creation time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "employee_profile_id": {
          "description": "Immutable external employee profile ID: emp_<ULID>.",
          "examples": [
            "emp_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^emp_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Employee Profile Id",
          "type": "string"
        },
        "entity_version": {
          "default": 1,
          "description": "Optimistic entity revision, independent of schema_version.",
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "id": {
          "description": "Immutable remediation intervention ID: intervention_<ULID>.",
          "examples": [
            "intervention_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^intervention_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "description": "Caller-generated idempotency key. It is not a domain entity ID.",
              "examples": [
                "idem_training_create_20260804_001"
              ],
              "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
          "title": "Metadata",
          "type": "object"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "description": "Single request ID: req_<ULID>.",
              "examples": [
                "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "required_course_ids": {
          "items": {
            "description": "Immutable external course ID: course_<ULID>.",
            "examples": [
              "course_01ARZ3NDEKTSV4RRFFQ69G5FAV"
            ],
            "pattern": "^course_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "title": "Required Course Ids",
          "type": "array"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "schema_version": {
          "default": "2.1.0",
          "description": "Contract schema semantic version.",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RemediationStatus"
        },
        "task_id": {
          "description": "Immutable external training task ID: task_<ULID>.",
          "examples": [
            "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Task Id",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "description": "Cross-service trace ID: trc_<ULID>.",
              "examples": [
                "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "updated_at": {
          "description": "Last update time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "updated_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated By"
        },
        "weak_knowledge_point_ids": {
          "items": {
            "description": "Immutable external knowledge point ID: kp_<ULID>.",
            "examples": [
              "kp_01ARZ3NDEKTSV4RRFFQ69G5FAV"
            ],
            "pattern": "^kp_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Weak Knowledge Point Ids",
          "type": "array"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "id",
        "status",
        "task_id",
        "assessment_result_id",
        "employee_profile_id",
        "weak_knowledge_point_ids",
        "reason",
        "attempt"
      ],
      "title": "RemediationIntervention",
      "type": "object"
    },
    "RemediationStatus": {
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "manual",
        "cancelled"
      ],
      "title": "RemediationStatus",
      "type": "string"
    },
    "RiskLevel": {
      "description": "Risk grading aligned with the document's read-only/low/medium/high levels.",
      "enum": [
        "read_only",
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.1.0:remediation-result-response",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/RemediationIntervention"
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiResponseMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "description": "Single request ID: req_<ULID>.",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.1.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "description": "Cross-service trace ID: trc_<ULID>.",
      "examples": [
        "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "occurred_at",
    "data"
  ],
  "title": "RemediationResultResponse",
  "type": "object",
  "x-contract-schema-version": "2.1.0",
  "x-contract-source": "backend.app.schemas.api.RemediationResultResponse"
}
