{
  "$defs": {
    "CursorPaginationMeta": {
      "additionalProperties": false,
      "description": "Cursor metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "cursor",
          "default": "cursor",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "page_size"
      ],
      "title": "CursorPaginationMeta",
      "type": "object"
    },
    "PageNumberPaginationMeta": {
      "additionalProperties": false,
      "description": "Page-number metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "page_size",
        "total"
      ],
      "title": "PageNumberPaginationMeta",
      "type": "object"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.1.0:api-response-meta",
  "additionalProperties": false,
  "description": "Optional response metadata; non-list responses do not emit empty pagination.",
  "properties": {
    "pagination": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageNumberPaginationMeta"
        },
        {
          "$ref": "#/$defs/CursorPaginationMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pagination"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "ApiResponseMeta",
  "type": "object",
  "x-contract-schema-version": "2.1.0",
  "x-contract-source": "backend.app.schemas.common.ApiResponseMeta"
}
