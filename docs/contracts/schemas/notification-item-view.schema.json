{
  "$defs": {
    "NotificationDestination": {
      "enum": [
        "task",
        "assessment",
        "remedial"
      ],
      "title": "NotificationDestination",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.2.0:notification-item-view",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "destination": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotificationDestination"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "icon": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Icon",
      "type": "string"
    },
    "id": {
      "description": "Immutable notification ID: notification_<ULID>.",
      "examples": [
        "notification_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^notification_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.2.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "description": "Immutable external training task ID: task_<ULID>.",
          "examples": [
            "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "title": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "unread": {
      "title": "Unread",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "created_at",
    "icon",
    "unread"
  ],
  "title": "NotificationItemView",
  "type": "object",
  "x-contract-schema-version": "2.2.0",
  "x-contract-source": "backend.app.schemas.experience.NotificationItemView"
}
