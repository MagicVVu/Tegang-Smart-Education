{
  "$defs": {
    "AgentCapability": {
      "enum": [
        "supervisor",
        "diagnosis",
        "retrieval",
        "planning",
        "rules",
        "approval",
        "skill",
        "assessment",
        "report"
      ],
      "title": "AgentCapability",
      "type": "string"
    },
    "AgentStepStatus": {
      "enum": [
        "pending",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "AgentStepStatus",
      "type": "string"
    },
    "RiskLevel": {
      "description": "Risk grading aligned with the document's read-only/low/medium/high levels.",
      "enum": [
        "read_only",
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.1.0:agent-step-summary",
  "additionalProperties": false,
  "description": "Auditable summary for one Agent execution step.",
  "properties": {
    "capability": {
      "$ref": "#/$defs/AgentCapability"
    },
    "checkpoint_id": {
      "anyOf": [
        {
          "description": "Agent checkpoint ID: checkpoint_<ULID>.",
          "examples": [
            "checkpoint_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^checkpoint_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Id"
    },
    "confidence": {
      "anyOf": [
        {
          "description": "Model or retrieval confidence in the closed interval [0, 1].",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "created_at": {
      "description": "Creation time with timezone; serialized as ISO 8601.",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "anyOf": [
        {
          "description": "Immutable external user ID: usr_<ULID>.",
          "examples": [
            "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By"
    },
    "decision_reason": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Reason"
    },
    "entity_version": {
      "default": 1,
      "description": "Optimistic entity revision, independent of schema_version.",
      "minimum": 1,
      "title": "Entity Version",
      "type": "integer"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "description": "Immutable Agent step ID: step_<ULID>.",
      "examples": [
        "step_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^step_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "description": "Caller-generated idempotency key. It is not a domain entity ID.",
          "examples": [
            "idem_training_create_20260804_001"
          ],
          "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "input_summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Input Summary",
      "type": "string"
    },
    "label": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
      "title": "Metadata",
      "type": "object"
    },
    "model_name": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "output_summary": {
      "default": "",
      "maxLength": 4000,
      "title": "Output Summary",
      "type": "string"
    },
    "prompt_version": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "request_id": {
      "anyOf": [
        {
          "description": "Single request ID: req_<ULID>.",
          "examples": [
            "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "retry_count": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel",
      "default": "low"
    },
    "run_id": {
      "description": "Immutable Agent run ID: run_<ULID>.",
      "examples": [
        "run_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.1.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_name": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skill Name"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/AgentStepStatus"
    },
    "token_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Count"
    },
    "trace_id": {
      "anyOf": [
        {
          "description": "Cross-service trace ID: trc_<ULID>.",
          "examples": [
            "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "updated_at": {
      "description": "Last update time with timezone; serialized as ISO 8601.",
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "updated_by": {
      "anyOf": [
        {
          "description": "Immutable external user ID: usr_<ULID>.",
          "examples": [
            "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated By"
    },
    "writes_committed": {
      "default": false,
      "title": "Writes Committed",
      "type": "boolean"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "id",
    "status",
    "run_id",
    "capability",
    "label",
    "input_summary"
  ],
  "title": "AgentStepSummary",
  "type": "object",
  "x-contract-schema-version": "2.1.0",
  "x-contract-source": "backend.app.schemas.agent.AgentStepSummary"
}
