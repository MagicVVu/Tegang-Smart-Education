{
  "$defs": {
    "ApiResponseMeta": {
      "additionalProperties": false,
      "description": "Optional response metadata; non-list responses do not emit empty pagination.",
      "properties": {
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageNumberPaginationMeta"
            },
            {
              "$ref": "#/$defs/CursorPaginationMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pagination"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "ApiResponseMeta",
      "type": "object"
    },
    "CursorPaginationMeta": {
      "additionalProperties": false,
      "description": "Cursor metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "cursor",
          "default": "cursor",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "page_size"
      ],
      "title": "CursorPaginationMeta",
      "type": "object"
    },
    "DemoProfile": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Account",
          "type": "string"
        },
        "department_ids": {
          "items": {
            "description": "Immutable external department ID: dept_<ULID>.",
            "examples": [
              "dept_01ARZ3NDEKTSV4RRFFQ69G5FAV"
            ],
            "pattern": "^dept_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "title": "Department Ids",
          "type": "array"
        },
        "display_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "primary_role": {
          "$ref": "#/$defs/UserRole"
        },
        "user_id": {
          "description": "Immutable external user ID: usr_<ULID>.",
          "examples": [
            "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "account",
        "user_id",
        "display_name",
        "primary_role"
      ],
      "title": "DemoProfile",
      "type": "object"
    },
    "PageNumberPaginationMeta": {
      "additionalProperties": false,
      "description": "Page-number metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "page_size",
        "total"
      ],
      "title": "PageNumberPaginationMeta",
      "type": "object"
    },
    "UserRole": {
      "enum": [
        "employee",
        "training_admin",
        "reviewer",
        "system_admin"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.2.0:demo-profiles-response",
  "additionalProperties": false,
  "properties": {
    "data": {
      "items": {
        "$ref": "#/$defs/DemoProfile"
      },
      "title": "Data",
      "type": "array"
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiResponseMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "description": "Single request ID: req_<ULID>.",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.2.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "description": "Cross-service trace ID: trc_<ULID>.",
      "examples": [
        "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "occurred_at",
    "data"
  ],
  "title": "DemoProfilesResponse",
  "type": "object",
  "x-contract-schema-version": "2.2.0",
  "x-contract-source": "backend.app.schemas.auth.DemoProfilesResponse"
}
