  "required": [
    "request_id",
    "trace_id",
    "occurred_at",
    "data"
  ],
  "title": "EmployeeIdentityResponse",
  "type": "object",
  "x-contract-schema-version": "2.2.0",
  "x-contract-source": "backend.app.schemas.auth.EmployeeIdentityResponse"
