{
  "$id": "urn:tegang:smart-education:contracts:2.0.0:api-envelope",
  "additionalProperties": false,
  "description": "Common response envelope fields; concrete responses add a typed data field.",
  "properties": {
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "description": "Single request ID: req_<ULID>.",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "description": "Cross-service trace ID: trc_<ULID>.",
      "examples": [
        "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "occurred_at"
  ],
  "title": "ApiEnvelope",
  "type": "object",
  "x-contract-schema-version": "2.0.0",
  "x-contract-source": "backend.app.schemas.common.ApiEnvelope"
}
