{
  "$defs": {
    "PlanGenerationInput": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Candidate Count",
          "type": "integer"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "required_course_ids": {
          "items": {
            "description": "Immutable external course ID: course_<ULID>.",
            "examples": [
              "course_01ARZ3NDEKTSV4RRFFQ69G5FAV"
            ],
            "pattern": "^course_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "title": "Required Course Ids",
          "type": "array"
        },
        "task_id": {
          "description": "Immutable external training task ID: task_<ULID>.",
          "examples": [
            "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Task Id",
          "type": "string"
        },
        "training_goal_id": {
          "description": "Immutable external training goal ID: goal_<ULID>.",
          "examples": [
            "goal_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Training Goal Id",
          "type": "string"
        }
      },
      "required": [
        "training_goal_id",
        "task_id"
      ],
      "title": "PlanGenerationInput",
      "type": "object"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.0.0:plan-generation-request",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "description": "Immutable external user ID: usr_<ULID>.",
      "examples": [
        "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Actor Id",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/PlanGenerationInput"
    },
    "idempotency_key": {
      "description": "Caller-generated idempotency key. It is not a domain entity ID.",
      "examples": [
        "idem_training_create_20260804_001"
      ],
      "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "request_id": {
      "description": "Single request ID: req_<ULID>.",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "description": "Cross-service trace ID: trc_<ULID>.",
      "examples": [
        "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "idempotency_key",
    "actor_id",
    "data"
  ],
  "title": "PlanGenerationRequest",
  "type": "object",
  "x-contract-schema-version": "2.0.0",
  "x-contract-source": "backend.app.schemas.api.PlanGenerationRequest"
}
