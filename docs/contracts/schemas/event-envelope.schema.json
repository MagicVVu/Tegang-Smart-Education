  "$id": "urn:tegang:smart-education:contracts:2.1.0:event-envelope",
  "additionalProperties": false,
  "description": "Immutable business event; transport and message-broker implementation are out of scope.",
  "properties": {
    "actor": {
      "$ref": "#/$defs/EventActor"
    },
    "aggregate_id": {
      "description": "Reference to a C-03 external entity ID; the owning schema defines the allowed prefix.",
      "examples": [
        "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^[a-z][a-z0-9_]*_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_type": {
      "$ref": "#/$defs/AggregateType"
    },
    "causation_id": {
      "anyOf": [
        {
          "description": "Reference to a C-03 external entity ID; the owning schema defines the allowed prefix.",
          "examples": [
            "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^[a-z][a-z0-9_]*_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "description": "Cross-service trace ID: trc_<ULID>.",
      "examples": [
        "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "deduplication_key": {
      "anyOf": [
        {
          "description": "Caller-generated idempotency key. It is not a domain entity ID.",
          "examples": [
            "idem_training_create_20260804_001"
          ],
          "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deduplication Key"
    },
    "event_id": {
      "description": "Immutable realtime event ID: event_<ULID>.",
      "examples": [
