{
  "$defs": {
    "UserRole": {
      "enum": [
        "employee",
        "training_admin",
        "reviewer",
        "system_admin"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.0.0:prototype-user-profile",
  "additionalProperties": false,
  "description": "Permission-safe signed-in user projection for prototype clients.",
  "properties": {
    "account_label": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Label"
    },
    "department_name": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Department Name",
      "type": "string"
    },
    "display_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "employee_profile_id": {
      "anyOf": [
        {
          "description": "Immutable external employee profile ID: emp_<ULID>.",
          "examples": [
            "emp_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^emp_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Employee Profile Id"
    },
    "job_title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Job Title",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/UserRole"
    },
    "schema_version": {
      "default": "2.0.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "user_id": {
      "description": "Immutable external user ID: usr_<ULID>.",
      "examples": [
        "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "display_name",
    "role",
    "department_name",
    "job_title"
  ],
  "title": "PrototypeUserProfile",
  "type": "object",
  "x-contract-schema-version": "2.0.0",
  "x-contract-source": "backend.app.schemas.experience.PrototypeUserProfile"
}
