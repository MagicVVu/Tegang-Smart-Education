{
  "$defs": {
    "RiskLevel": {
      "description": "Risk grading aligned with the document's read-only/low/medium/high levels.",
      "enum": [
        "read_only",
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "RuleCheckResult": {
      "enum": [
        "passed",
        "warning",
        "blocked"
      ],
      "title": "RuleCheckResult",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.2.0:rule-check-summary",
  "additionalProperties": false,
  "description": "Deterministic rule result referenced by a plan or task.",
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "description": "Model or retrieval confidence in the closed interval [0, 1].",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "created_at": {
      "description": "Creation time with timezone; serialized as ISO 8601.",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "anyOf": [
        {
          "description": "Immutable external user ID: usr_<ULID>.",
          "examples": [
            "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By"
    },
    "detail": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Detail",
      "type": "string"
    },
    "deterministic": {
      "default": true,
      "title": "Deterministic",
      "type": "boolean"
    },
    "entity_version": {
      "default": 1,
      "description": "Optimistic entity revision, independent of schema_version.",
      "minimum": 1,
      "title": "Entity Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^rule_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "description": "Caller-generated idempotency key. It is not a domain entity ID.",
          "examples": [
            "idem_training_create_20260804_001"
          ],
          "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "label": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
      "title": "Metadata",
      "type": "object"
    },
    "request_id": {
      "anyOf": [
        {
          "description": "Single request ID: req_<ULID>.",
          "examples": [
            "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel",
      "default": "low"
    },
    "rule_code": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Rule Code",
      "type": "string"
    },
    "schema_version": {
      "default": "2.2.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RuleCheckResult"
    },
    "trace_id": {
      "anyOf": [
        {
          "description": "Cross-service trace ID: trc_<ULID>.",
          "examples": [
            "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "updated_at": {
      "description": "Last update time with timezone; serialized as ISO 8601.",
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "updated_by": {
      "anyOf": [
        {
          "description": "Immutable external user ID: usr_<ULID>.",
          "examples": [
            "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated By"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "id",
    "status",
    "rule_code",
    "label",
    "detail"
  ],
  "title": "RuleCheckSummary",
  "type": "object",
  "x-contract-schema-version": "2.2.0",
  "x-contract-source": "backend.app.schemas.training.RuleCheckSummary"
}
