{
  "$defs": {
    "AgentRunStatus": {
      "description": "Agent execution states from chapter 15.8.",
      "enum": [
        "AR-PENDING",
        "AR-RUNNING",
        "AR-WAIT-INPUT",
        "AR-WAIT-APPROVAL",
        "AR-WAIT-EXTERNAL",
        "AR-RETRYING",
        "AR-ROLLING-BACK",
        "AR-REPLANNING",
        "AR-PAUSED",
        "AR-MANUAL",
        "AR-SUCCEEDED",
        "AR-FAILED",
        "AR-CANCELLED"
      ],
      "title": "AgentRunStatus",
      "type": "string"
    },
    "AgentState": {
      "additionalProperties": false,
      "description": "Serializable resumable Agent state, distinct from an API envelope or event.",
      "properties": {
        "checkpoint_id": {
          "anyOf": [
            {
              "description": "Agent checkpoint ID: checkpoint_<ULID>.",
              "examples": [
                "checkpoint_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^checkpoint_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Id"
        },
        "confidence": {
          "anyOf": [
            {
              "description": "Model or retrieval confidence in the closed interval [0, 1].",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "description": "Creation time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "current_approval_id": {
          "anyOf": [
            {
              "description": "Immutable external approval ID: approval_<ULID>.",
              "examples": [
                "approval_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^approval_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Approval Id"
        },
        "current_plan_id": {
          "anyOf": [
            {
              "description": "Immutable external training plan ID: plan_<ULID>.",
              "examples": [
                "plan_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Plan Id"
        },
        "current_step_id": {
          "anyOf": [
            {
              "description": "Immutable Agent step ID: step_<ULID>.",
              "examples": [
                "step_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^step_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Step Id"
        },
        "entity_version": {
          "default": 1,
          "description": "Optimistic entity revision, independent of schema_version.",
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "formal_write_occurred": {
          "default": false,
          "title": "Formal Write Occurred",
          "type": "boolean"
        },
        "id": {
          "description": "Immutable Agent run ID: run_<ULID>.",
          "examples": [
            "run_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "description": "Caller-generated idempotency key. It is not a domain entity ID.",
              "examples": [
                "idem_training_create_20260804_001"
              ],
              "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
          "title": "Metadata",
          "type": "object"
        },
        "recoverable": {
          "default": true,
          "title": "Recoverable",
          "type": "boolean"
        },
        "request_id": {
          "anyOf": [
            {
              "description": "Single request ID: req_<ULID>.",
              "examples": [
                "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retry_count": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "schema_version": {
          "default": "2.0.0",
          "description": "Contract schema semantic version.",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentRunStatus"
        },
        "task_id": {
          "description": "Immutable external training task ID: task_<ULID>.",
          "examples": [
            "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Task Id",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "description": "Cross-service trace ID: trc_<ULID>.",
              "examples": [
                "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "updated_at": {
          "description": "Last update time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "updated_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated By"
        },
        "waiting_for": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiting For"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "id",
        "status",
        "task_id"
      ],
      "title": "AgentState",
      "type": "object"
    },
    "RiskLevel": {
      "description": "Risk grading aligned with the document's read-only/low/medium/high levels.",
      "enum": [
        "read_only",
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.0.0:agent-state-response",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/AgentState"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "description": "Single request ID: req_<ULID>.",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "description": "Cross-service trace ID: trc_<ULID>.",
      "examples": [
        "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "occurred_at",
    "data"
  ],
  "title": "AgentStateResponse",
  "type": "object",
  "x-contract-schema-version": "2.0.0",
  "x-contract-source": "backend.app.schemas.api.AgentStateResponse"
}
