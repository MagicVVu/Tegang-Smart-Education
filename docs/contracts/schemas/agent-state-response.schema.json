{
  "$defs": {
    "AgentNextAction": {
      "enum": [
        "continue",
        "provide_input",
        "request_approval",
        "retry",
        "rollback",
        "replan",
        "request_human_takeover",
        "cancel",
        "complete"
      ],
      "title": "AgentNextAction",
      "type": "string"
    },
    "AgentRunStatus": {
      "description": "Agent execution states from chapter 15.8.",
      "enum": [
        "AR-PENDING",
        "AR-RUNNING",
        "AR-WAIT-INPUT",
        "AR-WAIT-APPROVAL",
        "AR-WAIT-EXTERNAL",
        "AR-RETRYING",
        "AR-ROLLING-BACK",
        "AR-REPLANNING",
        "AR-PAUSED",
        "AR-MANUAL",
        "AR-SUCCEEDED",
        "AR-FAILED",
        "AR-CANCELLED"
      ],
      "title": "AgentRunStatus",
      "type": "string"
    },
    "AgentState": {
      "additionalProperties": false,
      "description": "Serializable resumable Agent state, distinct from an API envelope or event.",
      "properties": {
        "checkpoint_id": {
          "anyOf": [
            {
              "description": "Agent checkpoint ID: checkpoint_<ULID>.",
              "examples": [
                "checkpoint_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^checkpoint_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Id"
        },
        "checkpoint_sequence": {
          "default": 0,
          "minimum": 0,
          "title": "Checkpoint Sequence",
          "type": "integer"
        },
        "checkpointed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpointed At"
        },
        "completed_step_ids": {
          "items": {
            "description": "Immutable Agent step ID: step_<ULID>.",
            "examples": [
              "step_01ARZ3NDEKTSV4RRFFQ69G5FAV"
            ],
            "pattern": "^step_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "title": "Completed Step Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "description": "Model or retrieval confidence in the closed interval [0, 1].",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "created_at": {
          "description": "Creation time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "current_approval_id": {
          "anyOf": [
            {
              "description": "Immutable external approval ID: approval_<ULID>.",
              "examples": [
                "approval_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^approval_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Approval Id"
        },
        "current_assessment_result_id": {
          "anyOf": [
            {
              "description": "Immutable assessment result ID: assessment_result_<ULID>.",
              "examples": [
                "assessment_result_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^assessment_result_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Assessment Result Id"
        },
        "current_knowledge_citation_ids": {
          "items": {
            "description": "Immutable external knowledge citation ID: know_<ULID>.",
            "examples": [
              "know_01ARZ3NDEKTSV4RRFFQ69G5FAV"
            ],
            "pattern": "^know_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "title": "Current Knowledge Citation Ids",
          "type": "array"
        },
        "current_node": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Node"
        },
        "current_plan_id": {
          "anyOf": [
            {
              "description": "Immutable external training plan ID: plan_<ULID>.",
              "examples": [
                "plan_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Plan Id"
        },
        "current_stage": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Stage"
        },
        "current_step_id": {
          "anyOf": [
            {
              "description": "Immutable Agent step ID: step_<ULID>.",
              "examples": [
                "step_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^step_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Step Id"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "entity_version": {
          "default": 1,
          "description": "Optimistic entity revision, independent of schema_version.",
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "formal_write_occurred": {
          "default": false,
          "title": "Formal Write Occurred",
          "type": "boolean"
        },
        "id": {
          "description": "Immutable Agent run ID: run_<ULID>.",
          "examples": [
            "run_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "description": "Caller-generated idempotency key. It is not a domain entity ID.",
              "examples": [
                "idem_training_create_20260804_001"
              ],
              "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "last_error_code": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error Code"
        },
        "last_error_id": {
          "anyOf": [
            {
              "description": "Immutable error occurrence ID: error_<ULID>.",
              "examples": [
                "error_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^error_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error Id"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
          "title": "Metadata",
          "type": "object"
        },
        "next_allowed_actions": {
          "items": {
            "$ref": "#/$defs/AgentNextAction"
          },
          "title": "Next Allowed Actions",
          "type": "array"
        },
        "pending_step_ids": {
          "items": {
            "description": "Immutable Agent step ID: step_<ULID>.",
            "examples": [
              "step_01ARZ3NDEKTSV4RRFFQ69G5FAV"
            ],
            "pattern": "^step_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "title": "Pending Step Ids",
          "type": "array"
        },
        "recoverable": {
          "default": true,
          "title": "Recoverable",
          "type": "boolean"
        },
        "request_id": {
          "anyOf": [
            {
              "description": "Single request ID: req_<ULID>.",
              "examples": [
                "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retry_count": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "schema_version": {
          "default": "2.1.0",
          "description": "Contract schema semantic version.",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "state_version": {
          "default": "1.0.0",
          "description": "Contract schema semantic version.",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "State Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AgentRunStatus"
        },
        "target_employee_profile_ids": {
          "items": {
            "description": "Immutable external employee profile ID: emp_<ULID>.",
            "examples": [
              "emp_01ARZ3NDEKTSV4RRFFQ69G5FAV"
            ],
            "pattern": "^emp_[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "title": "Target Employee Profile Ids",
          "type": "array"
        },
        "task_id": {
          "description": "Immutable external training task ID: task_<ULID>.",
          "examples": [
            "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Task Id",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "description": "Cross-service trace ID: trc_<ULID>.",
              "examples": [
                "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "training_goal_id": {
          "anyOf": [
            {
              "description": "Immutable external training goal ID: goal_<ULID>.",
              "examples": [
                "goal_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Goal Id"
        },
        "updated_at": {
          "description": "Last update time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "updated_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated By"
        },
        "waiting_for": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiting For"
        },
        "waiting_human_action": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiting Human Action"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "id",
        "status",
        "task_id"
      ],
      "title": "AgentState",
      "type": "object"
    },
    "ApiResponseMeta": {
      "additionalProperties": false,
      "description": "Optional response metadata; non-list responses do not emit empty pagination.",
      "properties": {
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageNumberPaginationMeta"
            },
            {
              "$ref": "#/$defs/CursorPaginationMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pagination"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "ApiResponseMeta",
      "type": "object"
    },
    "CursorPaginationMeta": {
      "additionalProperties": false,
      "description": "Cursor metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "cursor",
          "default": "cursor",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "page_size"
      ],
      "title": "CursorPaginationMeta",
      "type": "object"
    },
    "PageNumberPaginationMeta": {
      "additionalProperties": false,
      "description": "Page-number metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "page_size",
        "total"
      ],
      "title": "PageNumberPaginationMeta",
      "type": "object"
    },
    "RiskLevel": {
      "description": "Risk grading aligned with the document's read-only/low/medium/high levels.",
      "enum": [
        "read_only",
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.1.0:agent-state-response",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/AgentState"
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiResponseMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "description": "Single request ID: req_<ULID>.",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.1.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "description": "Cross-service trace ID: trc_<ULID>.",
      "examples": [
        "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "occurred_at",
    "data"
  ],
  "title": "AgentStateResponse",
  "type": "object",
  "x-contract-schema-version": "2.1.0",
  "x-contract-source": "backend.app.schemas.api.AgentStateResponse"
}
