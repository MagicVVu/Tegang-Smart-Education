{
  "$defs": {
    "ApiResponseMeta": {
      "additionalProperties": false,
      "description": "Optional response metadata; non-list responses do not emit empty pagination.",
      "properties": {
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageNumberPaginationMeta"
            },
            {
              "$ref": "#/$defs/CursorPaginationMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pagination"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "ApiResponseMeta",
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "approved",
        "approved_with_changes",
        "rejected",
        "returned_for_information"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ApprovalResult": {
      "additionalProperties": false,
      "description": "Concise result emitted after an approval action.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "description": "Model or retrieval confidence in the closed interval [0, 1].",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "description": "Creation time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "decision_comment": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Comment"
        },
        "entity_version": {
          "default": 1,
          "description": "Optimistic entity revision, independent of schema_version.",
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "id": {
          "description": "Immutable external approval ID: approval_<ULID>.",
          "examples": [
            "approval_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^approval_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "description": "Caller-generated idempotency key. It is not a domain entity ID.",
              "examples": [
                "idem_training_create_20260804_001"
              ],
              "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
          "title": "Metadata",
          "type": "object"
        },
        "plan_id": {
          "description": "Immutable external training plan ID: plan_<ULID>.",
          "examples": [
            "plan_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Plan Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "description": "Single request ID: req_<ULID>.",
              "examples": [
                "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "reviewer_id": {
          "description": "Immutable external user ID: usr_<ULID>.",
          "examples": [
            "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Reviewer Id",
          "type": "string"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "schema_version": {
          "default": "2.2.0",
          "description": "Contract schema semantic version.",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "task_id": {
          "description": "Immutable external training task ID: task_<ULID>.",
          "examples": [
            "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Task Id",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "description": "Cross-service trace ID: trc_<ULID>.",
              "examples": [
                "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "updated_at": {
          "description": "Last update time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "updated_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated By"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "id",
        "status",
        "task_id",
        "plan_id",
        "reviewer_id",
        "decision",
        "decided_at"
      ],
      "title": "ApprovalResult",
      "type": "object"
    },
    "ApprovalStatus": {
      "description": "Approval states from chapter 15.8.",
      "enum": [
        "AP-NOT-SUBMITTED",
        "AP-WAITING",
        "AP-EDITING",
        "AP-APPROVED",
        "AP-REJECTED",
        "AP-WITHDRAWN",
        "AP-EXPIRED",
        "AP-CANCELLED"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "CursorPaginationMeta": {
      "additionalProperties": false,
      "description": "Cursor metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "cursor",
          "default": "cursor",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "page_size"
      ],
      "title": "CursorPaginationMeta",
      "type": "object"
    },
    "PageNumberPaginationMeta": {
      "additionalProperties": false,
      "description": "Page-number metadata used only by list endpoints that select this strategy.",
      "properties": {
        "kind": {
          "const": "page",
          "default": "page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "page_size",
        "total"
      ],
      "title": "PageNumberPaginationMeta",
      "type": "object"
    },
    "RiskLevel": {
      "description": "Risk grading aligned with the document's read-only/low/medium/high levels.",
      "enum": [
        "read_only",
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.2.0:approval-result-response",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/ApprovalResult"
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiResponseMeta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "request_id": {
      "description": "Single request ID: req_<ULID>.",
      "examples": [
        "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.2.0",
      "description": "Contract schema semantic version.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "description": "Cross-service trace ID: trc_<ULID>.",
      "examples": [
        "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trace_id",
    "occurred_at",
    "data"
  ],
  "title": "ApprovalResultResponse",
  "type": "object",
  "x-contract-schema-version": "2.2.0",
  "x-contract-source": "backend.app.schemas.api.ApprovalResultResponse"
}
