{
  "$defs": {
    "PlanStatus": {
      "enum": [
        "draft",
        "candidate",
        "confirmed",
        "superseded"
      ],
      "title": "PlanStatus",
      "type": "string"
    }
  },
  "$id": "urn:tegang:smart-education:contracts:2.1.0:training-plan-event-payload",
  "additionalProperties": false,
  "properties": {
    "knowledge_citation_ids": {
      "items": {
        "description": "Immutable external knowledge citation ID: know_<ULID>.",
        "examples": [
          "know_01ARZ3NDEKTSV4RRFFQ69G5FAV"
        ],
        "pattern": "^know_[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "title": "Knowledge Citation Ids",
      "type": "array"
    },
    "plan_id": {
      "description": "Immutable external training plan ID: plan_<ULID>.",
      "examples": [
        "plan_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^plan_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Plan Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PlanStatus"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "description": "Immutable external training task ID: task_<ULID>.",
      "examples": [
        "task_01ARZ3NDEKTSV4RRFFQ69G5FAV"
      ],
      "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "task_id",
    "status",
    "summary"
  ],
  "title": "TrainingPlanEventPayload",
  "type": "object",
  "x-contract-schema-version": "2.1.0",
  "x-contract-source": "backend.app.schemas.events.TrainingPlanEventPayload"
}
