{
  "$defs": {
    "AgentCapability": {
      "enum": [
        "supervisor",
        "diagnosis",
        "retrieval",
        "planning",
        "rules",
        "approval",
        "skill",
        "assessment",
        "report"
      ],
      "title": "AgentCapability",
      "type": "string"
    },
    "AgentDecisionSource": {
      "enum": [
        "agent_suggestion",
        "deterministic_rule",
        "human_decision"
      ],
      "title": "AgentDecisionSource",
      "type": "string"
    },
    "AgentDecisionSummary": {
      "additionalProperties": false,
      "description": "Auditable decision summary without exposing prompts or hidden reasoning.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "description": "Model or retrieval confidence in the closed interval [0, 1].",
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "description": "Creation time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "entity_version": {
          "default": 1,
          "description": "Optimistic entity revision, independent of schema_version.",
          "minimum": 1,
          "title": "Entity Version",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "description": "Immutable Agent decision summary ID: decision_<ULID>.",
          "examples": [
            "decision_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^decision_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "description": "Caller-generated idempotency key. It is not a domain entity ID.",
              "examples": [
                "idem_training_create_20260804_001"
              ],
              "pattern": "^idem_[A-Za-z0-9._:-]{8,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Non-sensitive extension metadata. Secrets, prompts, stacks, and unauthorized data are forbidden.",
          "title": "Metadata",
          "type": "object"
        },
        "request_id": {
          "anyOf": [
            {
              "description": "Single request ID: req_<ULID>.",
              "examples": [
                "req_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "run_id": {
          "description": "Immutable Agent run ID: run_<ULID>.",
          "examples": [
            "run_01ARZ3NDEKTSV4RRFFQ69G5FAV"
          ],
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "2.1.0",
          "description": "Contract schema semantic version.",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/AgentDecisionSource"
        },
        "status": {
          "const": "recorded",
          "default": "recorded",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "description": "Cross-service trace ID: trc_<ULID>.",
              "examples": [
                "trc_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^trc_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "updated_at": {
          "description": "Last update time with timezone; serialized as ISO 8601.",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "updated_by": {
          "anyOf": [
            {
              "description": "Immutable external user ID: usr_<ULID>.",
              "examples": [
                "usr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
              ],
              "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated By"
        }
      },
      "required": [
        "created_at",
        "updated_at",
        "id",
        "run_id",
        "title",
        "summary",
        "source"
      ],
      "title": "AgentDecisionSummary",
      "type": "object"
    },
    "AgentNextAction": {
      "enum": [
        "continue",
        "provide_input",
        "request_approval",
        "retry",
        "rollback",
        "replan",
        "request_human_takeover",
        "cancel",
        "complete"
      ],
      "title": "AgentNextAction",
      "type": "string"
    },
    "AgentRunStatus": {
      "description": "Agent execution states from chapter 15.8.",
      "enum": [
        "AR-PENDING",
        "AR-RUNNING",
        "AR-WAIT-INPUT",
        "AR-WAIT-APPROVAL",
        "AR-WAIT-EXTERNAL",
        "AR-RETRYING",
        "AR-ROLLING-BACK",
        "AR-REPLANNING",
        "AR-PAUSED",
        "AR-MANUAL",
        "AR-SUCCEEDED",
        "AR-FAILED",
        "AR-CANCELLED"
      ],
      "title": "AgentRunStatus",
      "type": "string"
    },
    "AgentState": {
