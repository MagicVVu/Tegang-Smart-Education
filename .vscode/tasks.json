{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web：启动开发服务",
      "type": "shell",
      "command": "npx",
      "args": [
        "--yes",
        "pnpm@11.9.0",
        "dev:web"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
