# Copy this file to .env and fill values locally.
# Never commit .env or real credentials.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Provider-neutral placeholders; concrete providers are not selected yet.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

# Storage and retrieval choices remain open.
DATABASE_URL=
VECTOR_STORE_URL=

# Code prototype service boundary. Leave empty to use local Mock services.
VITE_API_BASE_URL=
EXPO_PUBLIC_API_BASE_URL=

# Demo-only controls; never place real tokens here.
VITE_DEMO_MODE=true
EXPO_PUBLIC_DEMO_MODE=true
