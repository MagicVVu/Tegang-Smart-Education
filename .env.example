# Copy to .env and fill locally. Never commit .env or real credentials.
# Empty values are intentional placeholders, not usable defaults.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OPENAPI_ENABLED=true

# Authentication. Generate AUTH_JWT_SECRET locally with at least 32 random characters.
# No fallback signing key is embedded in the application.
DEMO_MODE=false
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=tegang-smart-education
AUTH_JWT_AUDIENCE=tegang-clients
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false

# C-06 simulated identity bootstrap. Set local-only passwords only for the first seed.
# Existing credentials are left unchanged unless BOOTSTRAP_ROTATE_PASSWORDS=true.
BOOTSTRAP_E0231_PASSWORD=
BOOTSTRAP_A001_PASSWORD=
BOOTSTRAP_R001_PASSWORD=
BOOTSTRAP_S001_PASSWORD=
BOOTSTRAP_ROTATE_PASSWORDS=false

# Backend-only model configuration. Never expose MODEL_API_KEY through VITE_* or EXPO_PUBLIC_*.
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30

# Compose infrastructure. POSTGRES_PASSWORD must be a new local-only value.
POSTGRES_DB=tegang_smart_education
POSTGRES_USER=tegang_app
POSTGRES_PASSWORD=
# Host development uses 127.0.0.1; Compose injects its own db hostname and URL.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# Host port overrides.
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Public client configuration. These values may enter a browser/mobile bundle; never put secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
